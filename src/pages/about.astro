---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About" description="About AnimeNews">
  <section class="container" style="padding: 4rem 0; max-width: 700px;">
    <h1 style="margin-bottom: 1.5rem; background: var(--gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">About AnimeNews</h1>
    
    <div class="prose">
      <p>
        Welcome to <strong>AnimeNews</strong> — your cozy corner of the internet for everything anime.
      </p>
      <p>
        We cover the latest news, honest reviews, seasonal rankings, hidden gems, and deep-dive analysis 
        from both popular and underrated series.
      </p>
      <p>
        Whether you're into shonen battles, emotional slice-of-life, mind-bending psychological stories, 
        or pure comedy, there's always something new waiting for you here.
      </p>
      <h2>What you'll find</h2>
      <ul>
        <li>Weekly news roundups</li>
        <li>In-depth reviews & scores</li>
        <li>Seasonal guides & recommendations</li>
        <li>Character & lore analysis</li>
        <li>Top lists and ranking articles</li>
      </ul>
      <p>
        Made by anime fans, for anime fans. 🌸
      </p>
    </div>
  </section>
</BaseLayout>