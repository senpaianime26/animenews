---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Your daily source for anime news, reviews, and recommendations' } = Astro.props;
const siteTitle = title === 'Home' ? 'AnimeNews — Anime News & Reviews' : `${title} | AnimeNews`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{siteTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="logo">
          <span class="logo-icon">🌸</span>
          <span>AnimeNews</span>
        </a>
        <nav class="nav">
          <a href="/">Home</a>
          <a href="/blog">Blog</a>
          <a href="/about">About</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>© {new Date().getFullYear()} AnimeNews · Made with ❤️ for anime fans</p>
        <p style="margin-top: 0.4rem; font-size: 0.85rem;">
          Powered by <a href="https://astro.build" target="_blank">Astro</a> + Cloudflare Pages
        </p>
      </div>
    </footer>
  </body>
</html>